# =============================================================================
# EmbedShipped.cmake -- the shipped settings files, compiled into Huginn.dll
# =============================================================================
# Run as a script:
#   cmake -DMAIN_INI=<configs/Huginn.ini> -DDMENU_JSON=<.../Huginn.json>
#         -DOUT=<generated header> -P EmbedShipped.cmake
#
# Writes one header with the two files' bytes, byte for byte. They are the
# single source of truth for "the default" of every setting (0.24.10):
#   - configs/Huginn.ini: every main-INI key. A key the player's Huginn.ini
#     leaves out takes this file's value (settings/ShippedDefaults.h,
#     LoadMainIni), and dMenu's Reset to Defaults writes this file back.
#   - Huginn.json (dMenu's descriptor): the [Widget] and [Debug] defaults,
#     its "default" fields, the values dMenu writes on a fresh install.
# The root CMakeLists.txt reruns this whenever either file (or this script)
# changes, and huginn_core_tests compares the bytes with the repo files.
# =============================================================================

if(NOT MAIN_INI OR NOT DMENU_JSON OR NOT OUT)
   message(FATAL_ERROR "EmbedShipped: pass -DMAIN_INI=... -DDMENU_JSON=... -DOUT=...")
endif()

# hex -> "0x3b,0x20,..." with a line break every 24 bytes. CMake's regex has
# no {n} repetition, so the wrap is a loop over 48-hex-digit chunks.
function(huginn_hex_array path out_var size_var)
   file(READ "${path}" hex HEX)
   string(LENGTH "${hex}" hex_len)
   math(EXPR size "${hex_len} / 2")
   set(bytes "")
   set(pos 0)
   while(pos LESS hex_len)
      string(SUBSTRING "${hex}" ${pos} 48 chunk)
      string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
      if(pos GREATER 0)
         string(APPEND bytes "\n   ")
      endif()
      string(APPEND bytes "${chunk}")
      math(EXPR pos "${pos} + 48")
   endwhile()
   set(${out_var} "${bytes}" PARENT_SCOPE)
   set(${size_var} "${size}" PARENT_SCOPE)
endfunction()

huginn_hex_array("${MAIN_INI}" main_bytes main_size)
huginn_hex_array("${DMENU_JSON}" json_bytes json_size)
if(main_size EQUAL 0 OR json_size EQUAL 0)
   message(FATAL_ERROR "EmbedShipped: an input file is empty (${MAIN_INI}: ${main_size}, ${DMENU_JSON}: ${json_size})")
endif()

set(content "// Generated by cmake/EmbedShipped.cmake. Do not edit: edit configs/Huginn.ini
// or Data/SKSE/Plugins/dmenu/customSettings/Huginn.json and rebuild.
#pragma once

#include <cstddef>
#include <string_view>

namespace Huginn::Shipped
{
   // configs/Huginn.ini, ${main_size} bytes.
   inline constexpr unsigned char kMainIniBytes[] = {
   ${main_bytes}
   };
   inline constexpr std::size_t kMainIniSize = ${main_size};

   // Data/SKSE/Plugins/dmenu/customSettings/Huginn.json, ${json_size} bytes.
   inline constexpr unsigned char kDMenuJsonBytes[] = {
   ${json_bytes}
   };
   inline constexpr std::size_t kDMenuJsonSize = ${json_size};

   static_assert(sizeof(kMainIniBytes) == kMainIniSize);
   static_assert(sizeof(kDMenuJsonBytes) == kDMenuJsonSize);

   inline std::string_view MainIniText() noexcept
   {
      return { reinterpret_cast<const char*>(kMainIniBytes), kMainIniSize };
   }
   inline std::string_view DMenuJsonText() noexcept
   {
      return { reinterpret_cast<const char*>(kDMenuJsonBytes), kDMenuJsonSize };
   }
}
")

# Always written: the custom command runs only when an input is newer than
# this header, and a header left older than its inputs would rerun it on every
# build.
file(WRITE "${OUT}" "${content}")
